QWidget {
    color: #202124;
    font-family: "Microsoft JhengHei UI", "Microsoft JhengHei", "Segoe UI";
    font-size: 13px;
}

QMainWindow, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #f5f7fa;
}

QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #dfe3e8;
    padding: 3px;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 5px;
}

QMenuBar::item:selected, QMenu::item:selected {
    background: #e9f2ff;
}

QMenu {
    background: #ffffff;
    border: 1px solid #ccd3dc;
    padding: 5px;
}

QMenu::item {
    padding: 7px 28px 7px 10px;
}

QLabel#brand {
    color: #155eef;
    font-size: 28px;
    font-weight: 800;
}

QLabel#productName {
    color: #172b4d;
    font-size: 18px;
    font-weight: 700;
}

QLabel#headerStatus {
    background: #eef2f6;
    border: 1px solid #d7dde5;
    border-radius: 12px;
    padding: 6px 12px;
    color: #52606d;
}

QLabel#headerStatus[state="ready"] {
    background: #e7f8ef;
    border-color: #a7dfbe;
    color: #137a45;
}

QLabel#headerStatus[state="offline"] {
    background: #fff1f0;
    border-color: #ffc5bf;
    color: #b42318;
}

QLabel#metricValue {
    color: #172b4d;
    font-size: 15px;
    font-weight: 700;
}

QLabel[muted="true"] {
    color: #667085;
}

QLabel[warning="true"], QLabel[warningIcon="true"] {
    color: #9a6700;
}

QLabel[sectionTitle="true"] {
    color: #172b4d;
    font-size: 18px;
    font-weight: 700;
}

/* ============================================================
   區塊（GroupBox）— 依功能分色
   ============================================================ */

QGroupBox {
    background: #ffffff;
    border: 1px solid #d9dfe7;
    border-radius: 8px;
    border-left: 4px solid #d9dfe7;
    margin-top: 10px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #344054;
}

/* ASR 引擎區塊：藍色系 */
QGroupBox[zone="asr"] {
    background: #f0f6ff;
    border-color: #b8d4f8;
    border-left: 4px solid #155eef;
}

QGroupBox[zone="asr"]::title {
    color: #155eef;
}

/* 翻譯引擎區塊：紫色系 */
QGroupBox[zone="translation"] {
    background: #f5f0ff;
    border-color: #c9b8f8;
    border-left: 4px solid #7c3aed;
}

QGroupBox[zone="translation"]::title {
    color: #7c3aed;
}

/* 專案/媒體區塊：綠色系 */
QGroupBox[zone="project"] {
    background: #f0faf4;
    border-color: #b8e8c8;
    border-left: 4px solid #16a34a;
}

QGroupBox[zone="project"]::title {
    color: #16a34a;
}

/* 輸出/報告區塊：橙色系 */
QGroupBox[zone="output"] {
    background: #fff8f0;
    border-color: #f8d8b8;
    border-left: 4px solid #ea580c;
}

QGroupBox[zone="output"]::title {
    color: #ea580c;
}

/* 警告面板 */
QFrame[warningPanel="true"] {
    background: #fff8e6;
    border: 1px solid #f4d58d;
    border-radius: 8px;
}

/* ============================================================
   按鈕 — 依語義分色
   ============================================================ */

QPushButton {
    min-height: 30px;
    background: #ffffff;
    border: 1px solid #bfc7d2;
    border-radius: 6px;
    padding: 2px 13px;
    color: #344054;
}

QPushButton:hover {
    background: #f2f6fb;
    border-color: #8ca1ba;
}

QPushButton:pressed {
    background: #e7eef7;
}

QPushButton:disabled {
    color: #98a2b3;
    background: #f2f4f7;
    border-color: #e1e5ea;
}

/* 主要動作（藍色） */
QPushButton[primary="true"] {
    color: #ffffff;
    background: #155eef;
    border-color: #155eef;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background: #0b4bd4;
}

QPushButton[primary="true"]:pressed {
    background: #0940b8;
}

/* 啟動/成功（綠色） */
QPushButton[success="true"] {
    color: #ffffff;
    background: #16a34a;
    border-color: #16a34a;
    font-weight: 600;
}

QPushButton[success="true"]:hover {
    background: #128a3e;
}

QPushButton[success="true"]:pressed {
    background: #0f7534;
}

/* 停止/危險（紅色） */
QPushButton[danger="true"] {
    color: #ffffff;
    background: #dc2626;
    border-color: #dc2626;
    font-weight: 600;
}

QPushButton[danger="true"]:hover {
    background: #b91c1c;
}

QPushButton[danger="true"]:pressed {
    background: #991b1b;
}

/* 警告/注意（橙色） */
QPushButton[warning="true"] {
    color: #ffffff;
    background: #ea580c;
    border-color: #ea580c;
    font-weight: 600;
}

QPushButton[warning="true"]:hover {
    background: #c2410c;
}

QPushButton[warning="true"]:pressed {
    background: #9a3412;
}

/* ============================================================
   輸入與表格
   ============================================================ */

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit {
    background: #ffffff;
    border: 1px solid #c7ced8;
    border-radius: 5px;
    padding: 5px 7px;
    selection-background-color: #bfd4ff;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #3478f6;
}

QComboBox {
    min-height: 24px;
}

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d9dfe7;
    border-radius: 7px;
    top: -1px;
}

QTabBar::tab {
    background: #eef1f5;
    border: 1px solid #d9dfe7;
    border-bottom: none;
    padding: 8px 14px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #155eef;
    font-weight: 700;
}

QTableView, QTreeView, QListWidget {
    background: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #d9dfe7;
    border-radius: 5px;
    gridline-color: #e9edf2;
    selection-background-color: #dce9ff;
    selection-color: #172b4d;
}

QHeaderView::section {
    background: #edf1f6;
    color: #344054;
    border: none;
    border-right: 1px solid #d9dfe7;
    border-bottom: 1px solid #d9dfe7;
    padding: 7px;
    font-weight: 700;
}

QProgressBar {
    min-height: 9px;
    border: 1px solid #d1d8e0;
    border-radius: 5px;
    background: #e9edf2;
    text-align: center;
}

QProgressBar::chunk {
    background: #3478f6;
    border-radius: 4px;
}

QSplitter::handle {
    background: transparent;
    width: 7px;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #dfe3e8;
}
